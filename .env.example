# tailscale oauth credentials
TS_CLIENT_ID=your_tailscale_client_id
TS_CLIENT_SECRET=your_tailscale_client_secret

# Zenoh router endpoint (use the publisher's Tailscale IP on remote subscribers)
ZENOH_CONNECT=tcp/127.0.0.1:7447

# legacy ROS bag configuration only
ROS_DOMAIN_ID=14

# rosbag api
ROSBAG_API_PORT=8080

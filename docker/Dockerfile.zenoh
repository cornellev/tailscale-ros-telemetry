FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /workspace

COPY src/py_pubsub /opt/py_pubsub
# Fail clearly if the sensor-reader submodule was not initialized.
RUN test -f /opt/py_pubsub/py_pubsub/uc26_sensor_reader/read_shm.py \
    && pip install --no-cache-dir /opt/py_pubsub

COPY docker/entrypoint-ros.sh /entrypoint-ros.sh
COPY docker/entrypoint-subscriber.sh /entrypoint-subscriber.sh
RUN chmod +x /entrypoint-ros.sh /entrypoint-subscriber.sh

ENTRYPOINT ["/entrypoint-ros.sh"]
